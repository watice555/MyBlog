{
  "name": "watice-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:generate": "node scripts/generate-posts.mjs",
    "edit:local": "./scripts/start-local-editor.command",
    "predev": "npm run content:generate",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run content:generate",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prebuild:github": "npm run content:generate",
    "build:github": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:export": "node --experimental-strip-types --test tests/static-export.check.mjs",
    "typecheck:local": "tsc -p tsconfig.local.json",
    "prelint": "npm run content:generate",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next && npm run typecheck:local"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "katex": "^0.16.47",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "gray-matter": "^4.0.3",
    "js-yaml": "4.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.0.16",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
